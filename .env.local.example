# Supabase (auth, database, and all non-attachment data)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# PostHog (optional)
VITE_POSTHOG_API_KEY=your_posthog_api_key

# Neon — pulled automatically by `neon init` / `neon deploy` from neon.ts.
# Postgres (declared in neon.ts but app data stays in Supabase):
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
NEON_BRANCH_ID=

# Object storage (used server-side by the `attach` Neon Function only;
# these are injected into the Function at runtime and never bundled into the app):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# Neon Functions host suffix, used by Vite to build the attachment signer URL:
NEON_FUNCTION_HOST_SUFFIX=

# The `attach` Function reuses VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY above
# to validate tokens through Supabase /auth/v1/user.
